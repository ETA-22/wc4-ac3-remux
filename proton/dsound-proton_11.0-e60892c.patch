+/* Scale applied to buffer attenuations (lVolume) before mixing. 1.0 = as
+ * the application asked; 0.5 halves every attenuation (e.g. -5.12 dB becomes
+ * -2.56 dB). Wing Commander IV mixes its speech 5 dB under its music bed, so it
+ * defaults to 0.5 for WC IV's executables and 1.0 for everything else.
+ * Override with WINE_DSOUND_VOLUME_SCALE=<0..1>. */
+static double volume_scale(void)
+{
+	static double scale = -1.0;
+	if (scale < 0.0)
+	{
+		const char *env = getenv("WINE_DSOUND_VOLUME_SCALE");
+		char exe[MAX_PATH], *name;
+		double def = 1.0;
+
+		if (GetModuleFileNameA(NULL, exe, sizeof(exe)))
+		{
+			name = strrchr(exe, '\\');
+			name = name ? name + 1 : exe;
+			if (!_stricmp(name, "wc4dvd.exe") || !_stricmp(name, "wc4w.exe"))
+				def = 0.5;
+		}
+		scale = env ? atof(env) : def;
+		if (!(scale >= 0.0 && scale <= 1.0)) scale = def;
+		TRACE("volume scale %.2f\n", scale);
+	}
+	return scale;
+}
+
