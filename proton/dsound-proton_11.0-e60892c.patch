 	/* the AmpFactors are expressed in 16.16 fixed point */
 
 	/* FIXME: use calculated vol and pan ampfactors */
-	temp = (double) (volpan->lVolume - (volpan->lPan > 0 ? volpan->lPan : 0));
+	vol = volpan->lVolume * volume_scale();
+	temp = vol - (volpan->lPan > 0 ? volpan->lPan : 0);
 	volpan->dwTotalAmpFactor[0] = (ULONG) (pow(2.0, temp / 600.0) * 0xffff);
-	temp = (double) (volpan->lVolume + (volpan->lPan < 0 ? volpan->lPan : 0));
+	temp = vol + (volpan->lPan < 0 ? volpan->lPan : 0);
 	volpan->dwTotalAmpFactor[1] = (ULONG) (pow(2.0, temp / 600.0) * 0xffff);
 
+	/* Channels beyond front left/right get the volume without pan. They used
