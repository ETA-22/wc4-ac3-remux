From 7895df274a9549c64404e1d96123648dac3e0cfb Mon Sep 17 00:00:00 2001
From: Evan Adnams <eadnams@gmail.com>
Date: Sat, 7 Nov 2026 22:03:37 -0600
Subject: [PATCH 2/3] dsound: Handle mono to 7.1 conversion in the mono branch.

The ichannels == 1 branch of DSOUND_RecalcFormat() only handled 2, 4
and 6 output channels, which made the later ichannels == 1 && ochannels
== 8 branch unreachable. A mono buffer on 7.1 output was left without an
out_channel_map for its new format.

Move the 7.1 case into the mono branch.
---
 dlls/dsound/mixer.c | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/dlls/dsound/mixer.c b/dlls/dsound/mixer.c
index e7b1593..f82e992 100644
--- a/dlls/dsound/mixer.c
+++ b/dlls/dsound/mixer.c
@@ -396,6 +396,8 @@ void DSOUND_RecalcFormat(IDirectSoundBufferImpl *dsb)
 			dsb->out_channel_map = &channel_map_mono2quad;
 		else if (ochannels == 6)
 			dsb->out_channel_map = &channel_map_mono2surround51;
+		else if (ochannels == 8)
+			dsb->out_channel_map = &channel_map_mono2surround71;
 	}
 	else if (ochannels == 1)
 	{
@@ -427,11 +429,6 @@ void DSOUND_RecalcFormat(IDirectSoundBufferImpl *dsb)
 		dsb->mix_channels = 4;
 		dsb->out_channel_map = &channel_map_quad2stereo;
 	}
-	else if (ichannels == 1 && ochannels == 8)
-	{
-		dsb->mix_channels = 1;
-		dsb->out_channel_map = &channel_map_mono2surround71;
-	}
 	else if (ichannels == 2 && ochannels == 8)
 	{
 		dsb->mix_channels = 2;
