From 0bae55705d5de62aedda6b61ca1de16736b24d12 Mon Sep 17 00:00:00 2001
From: Evan Adnams <eadnams@gmail.com>
Date: Sat, 7 Nov 2026 22:03:37 -0600
Subject: [PATCH 1/3] dsound: Apply the buffer volume to all output channels.

DSOUND_RecalcVolPan() only computed the amplification factors of the
first two channels, but DSOUND_MixerVol() applies dwTotalAmpFactor[] to
every output channel. On 5.1 and 7.1 output, any secondary buffer with a
volume or pan set therefore lost its centre, LFE and surround channels,
while buffers at 0 dB were left untouched, so a game's quieter sounds
dropped out of most speakers.

Give every channel past the first two the buffer volume; the pan still
only applies to left and right.
---
 dlls/dsound/mixer.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/dlls/dsound/mixer.c b/dlls/dsound/mixer.c
index 127ec86..e7b1593 100644
--- a/dlls/dsound/mixer.c
+++ b/dlls/dsound/mixer.c
@@ -69,6 +69,12 @@ void DSOUND_RecalcVolPan(PDSVOLUMEPAN volpan)
 	temp = (double) (volpan->lVolume + (volpan->lPan < 0 ? volpan->lPan : 0));
 	volpan->dwTotalAmpFactor[1] = (ULONG) (pow(2.0, temp / 600.0) * 0xffff);
 
+	/* The pan only affects the left and right channels; every other channel
+	 * gets the buffer volume. */
+	temp = (double) volpan->lVolume;
+	for (unsigned int i = 2; i < DS_MAX_CHANNELS; i++)
+		volpan->dwTotalAmpFactor[i] = (ULONG) (pow(2.0, temp / 600.0) * 0xffff);
+
 	TRACE("left = %lx, right = %lx\n", volpan->dwTotalAmpFactor[0], volpan->dwTotalAmpFactor[1]);
 }
 
